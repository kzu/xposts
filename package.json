{
  "name": "xposts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A verifiable archive of X posts: rendered with xeet, served by Vercel, stored in Azure Blob Storage.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx --env-file=.env.local dev.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --jsx=automatic --jsx-import-source=hono/jsx --outfile=dist/main.js"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@xeet/core": "0.1.0",
    "hono": "^4.13.18",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
