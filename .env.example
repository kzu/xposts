# Local secrets for `npm run dev`. Copy to .dev.vars; every integration is optional.

# Auth0 (Regular Web Application). Callback URL: http://localhost:8787/auth/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
SESSION_SECRET=

# X API: bearer token reads posts; the OAuth 1.0a keys belong to the bot account.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BOT_USER_ID=

# Algorand: the 25 words of the account that anchors captures (testnet by default).
ALGORAND_MNEMONIC=
