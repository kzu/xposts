# Settings for `npm run dev`. Copy to .env.local.

# Required: the storage account that holds the saves.
AZURE_STORAGE_CONNECTION_STRING=

PUBLIC_URL=http://localhost:3000

# Auth0 (Regular Web Application). Callback URL: http://localhost:3000/auth/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
SESSION_SECRET=

# X API: the bearer token reads posts; the OAuth 1.0a keys belong to the bot account.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BOT_USER_ID=
X_BOT_HANDLE=SaveXPosts

# What the scheduler presents to /api/cron/mentions.
CRON_SECRET=
