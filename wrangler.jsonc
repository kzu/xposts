{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xposts",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Holds the xeet font packs (39 MB, too large for the Worker bundle). The
  // Worker runs first for every request and never routes to them, so the
  // packs are readable only through the ASSETS binding.
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xposts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "xposts" }],
  "queues": {
    "producers": [{ "binding": "ARCHIVE_QUEUE", "queue": "xposts-archive" }],
    "consumers": [
      {
        "queue": "xposts-archive",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "xposts-archive-dlq"
      }
    ]
  },

  // Polls X for mentions of the bot account.
  "triggers": { "crons": ["*/2 * * * *"] },

  "vars": {
    "PUBLIC_URL": "http://localhost:8787",
    "X_BOT_HANDLE": "SaveXPosts",
    "ALGORAND_NETWORK": "testnet"
  }
}
